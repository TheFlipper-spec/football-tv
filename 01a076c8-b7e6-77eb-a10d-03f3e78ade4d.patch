+  position      TEXT,
+  country       TEXT,
+  dob           TEXT,
+  height_cm     INTEGER,
+  statsbomb_id  INTEGER
+);
+
+CREATE TABLE IF NOT EXISTS matches (
+  id              TEXT PRIMARY KEY,
+  competition_id  TEXT REFERENCES competitions(id) ON DELETE SET NULL,
+  season_id       TEXT REFERENCES seasons(id) ON DELETE SET NULL,
