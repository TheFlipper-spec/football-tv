+          alive &&
+          setState((s) => ({
+            data: s.data,                       // при ошибке не затираем то, что уже показали
+            error: String(error.message || error),
+            loading: false,
+            fetched_at: new Date().toISOString(),
+          })),
+        );
+    };
+    run(true);
