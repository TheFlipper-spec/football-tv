{
  "name": "football-tv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Футбол.TV — реальные матчи, составы, статистика и прямые трансляции из VK Видео Live / OK.ru",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "vite --config vite.config.js",
    "ingest": "node --disable-warning=ExperimentalWarning ingest/index.js",
    "ingest:openfootball": "node --disable-warning=ExperimentalWarning ingest/index.js --only=openfootball",
    "ingest:statsbomb": "node --disable-warning=ExperimentalWarning ingest/index.js --only=statsbomb",
    "ingest:streams": "node --disable-warning=ExperimentalWarning ingest/index.js --only=streams",
    "ingest:live": "node --disable-warning=ExperimentalWarning ingest/index.js --only=espn",
    "build": "vite build",
    "build:pages": "VITE_BASE=/football-tv/ vite build && node --disable-warning=ExperimentalWarning scripts/export-static.js --base=/football-tv/",
    "exe": "node sea/build.mjs",
    "export:static": "node --disable-warning=ExperimentalWarning scripts/export-static.js",
    "serve:static": "node --disable-warning=ExperimentalWarning scripts/serve-static.js",
    "test": "node --test tests/*.test.js",
    "test:smoke": "esbuild scripts/smoke.jsx --bundle --platform=node --format=esm --jsx=automatic --outfile=.cache/smoke.mjs --log-level=error --external:react --external:react-dom --external:react-router-dom --external:jsdom && node .cache/smoke.mjs",
    "test:smoke:static": "esbuild scripts/smoke.jsx --bundle --platform=node --format=esm --jsx=automatic --outfile=.cache/smoke-static.mjs --log-level=error --external:react --external:react-dom --external:react-router-dom --external:jsdom --define:import.meta.env.BASE_URL='\"/football-tv/\"' && STATIC=1 ORIGIN=http://127.0.0.1:8090 PAGE_URL=http://127.0.0.1:8090/football-tv/ node .cache/smoke-static.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "postject": "^1.0.0-alpha.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.11"
  }
}
